{
  "schema_version": 1,
  "dataset": {
    "feature_contract_path": "config/metropt3_feature_engineering.json",
    "feature_parquet_path": "data/processed/metropt3_features.parquet",
    "feature_evidence_path": "outputs/metropt3_feature_engineering_report.json",
    "eligibility_parquet_path": "data/processed/metropt3_baseline_eligibility.parquet",
    "eligibility_evidence_path": "outputs/metropt3_baseline_evaluation_contract_report.json"
  },
  "fit": {
    "partition": "train",
    "eligibility_column": "eligible_for_reference_fit",
    "location": "median",
    "scale": "interquartile_range",
    "zero_iqr_policy": "exclude_feature_and_record_reason"
  },
  "score": {
    "method": "maximum_absolute_robust_z_score",
    "threshold_quantile": 0.995,
    "threshold_fit_population": "eligible_training_reference_scores",
    "threshold_frozen_before_validation": true
  },
  "validation": {
    "partition": "validation",
    "test_partition_locked": true,
    "documented_positive_state": "documented_failure",
    "unlabeled_state": "unverified",
    "expected_sampling_seconds": 10.0
  },
  "outputs": {
    "parameters": "outputs/metropt3_robust_distance_parameters.json",
    "validation_scores": "data/processed/metropt3_validation_robust_distance.parquet",
    "report": "outputs/metropt3_robust_distance_validation_report.json",
    "compression": "zstd"
  }
}
